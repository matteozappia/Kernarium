# SPDX-License-Identifier: Apache-2.0
on early-init
    # The launcher passes it from the vCPU count; a launch with none gets 5.
    setprop ro.hw_timeout_multiplier ${ro.boot.hw_timeout_multiplier:-5}
    setprop hypervisor.memory_reclaim.supported ${ro.boot.hypervisor.vm.supported}
    setprop ro.setupwizard.mode ${ro.boot.setupwizard_mode}
    # Graphics configuration. The tracked boot command line sets every
    # ro.boot property copied here.
    setprop ro.hardware.egl ${ro.boot.hardware.egl}
    setprop debug.sf.vsync_reactor_ignore_present_fences true
    setprop ro.hardware.gralloc ${ro.boot.hardware.gralloc}
    setprop ro.hardware.hwcomposer ${ro.boot.hardware.hwcomposer}
    setprop ro.vendor.hwcomposer.display_finder_mode ${ro.boot.hardware.hwcomposer.display_finder_mode}
    setprop ro.vendor.hwcomposer.display_framebuffer_format ${ro.boot.hardware.hwcomposer.display_framebuffer_format}
    setprop ro.hardware.vulkan ${ro.boot.hardware.vulkan}
    setprop ro.cpuvulkan.version ${ro.boot.cpuvulkan.version}
    setprop ro.opengles.version ${ro.boot.opengles.version}
    setprop debug.hwui.renderer ${ro.boot.hardware.guest_hwui_renderer}
    setprop ro.zygote.disable_gl_preload ${ro.boot.hardware.guest_disable_renderer_preload}
    # The Venus HAL waits for each vkAllocateMemory reply, so a host GPU
    # budget refusal reaches the application as VK_ERROR_OUT_OF_DEVICE_MEMORY
    # instead of aborting it. Mesa reads VN_PERF as this property, a
    # debug_prop every domain may read; early-init runs before any service or
    # application that loads the driver starts.
    setprop debug.mesa.vn.perf no_async_mem_alloc

# Kernarium passes the display density at each launch. The standalone macOS
# launcher passes none, which leaves SurfaceFlinger on its fallback density.
on early-init && property:ro.boot.lcd_density=*
    setprop ro.sf.lcd_density ${ro.boot.lcd_density}

on fs
    mount_all --early
    chmod 622 /dev/kmsg

on late-fs
    mount_all --late
    write /dev/kmsg "GUEST_BUILD_FINGERPRINT: ${ro.build.fingerprint}"
    # Add-on layers: what a package flashed in recovery installed for the
    # system, system_ext and product partitions (tools/kernarium_addons.sh).
    # Each is an ext4 image on userdata whose layer/ directory exists only
    # when it holds a payload; it is mounted read-only under the real
    # partition before apexd and the zygote read either. A guest with no
    # add-ons has no image or no layer/, the mount fails and the partition
    # stays as the release made it.
    mkdir /mnt/vendor/kernarium_addons 0755 root root
    mkdir /mnt/vendor/kernarium_addons/system 0755 root root
    mkdir /mnt/vendor/kernarium_addons/system_ext 0755 root root
    mkdir /mnt/vendor/kernarium_addons/product 0755 root root
    mount ext4 loop@/data/vendor/kernarium_addons/system.img /mnt/vendor/kernarium_addons/system ro noatime
    mount ext4 loop@/data/vendor/kernarium_addons/system_ext.img /mnt/vendor/kernarium_addons/system_ext ro noatime
    mount ext4 loop@/data/vendor/kernarium_addons/product.img /mnt/vendor/kernarium_addons/product ro noatime
    mount overlay overlay /system ro lowerdir=/mnt/vendor/kernarium_addons/system/layer:/system
    mount overlay overlay /system_ext ro lowerdir=/mnt/vendor/kernarium_addons/system_ext/layer:/system_ext
    mount overlay overlay /product ro lowerdir=/mnt/vendor/kernarium_addons/product/layer:/product

# The host may have grown the userdata partition since the last boot. Once
# /data is mounted, and before the zygote starts, the kernel's online resize
# grows the filesystem to the partition: it is journaled, needs no fsck, and
# adds the group descriptor blocks the compact image has no room for. With
# nothing to grow resize2fs does nothing. It runs as root with the group of
# /data's owner, so it opens /data (mode 0771) without a DAC capability.
on post-fs-data
    exec - root system -- /system/bin/resize2fs /dev/block/by-name/userdata

on boot
    setprop ro.hardware.audio.primary goldfish
    # The Wi-Fi HAL and the supplicant keep their sockets and configuration here.
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    setprop service.adb.tcp.port 5555
    start adbd

# adbd is the host application's channel and has to keep running whatever the
# debugging setting. AdbService restarts it where stock stops it; this starts it
# again after any other stop (a USB configuration rule). Only a stopped service
# raises the trigger: a crash is init's own restart, and a restart passes
# through "stopping" and "restarting", never "stopped". Shutdown runs no
# actions. start clears the stop's disabled flag.
on property:init.svc.adbd=stopped
    start adbd

# eth0, the host's user-mode network, is the management NIC adb is reached on:
# it keeps 10.0.2.15 and the framework never manages it. The tool addresses it,
# has the host's DHCP server reserve the address, keeps adb's replies on eth0,
# and builds the virtual Wi-Fi interface the framework sees on top of it. init
# waits for the tool, so adbd and the framework find the interfaces in place.
# Every interface answers ARP only for its own addresses, so the Wi-Fi lease
# never takes over the management address.
service kernarium_net_setup /vendor/bin/kernarium_net_setup
    user root
    oneshot
    disabled

on post-fs-data
    write /proc/sys/net/ipv4/conf/all/arp_ignore 1
    write /proc/sys/net/ipv4/conf/all/arp_announce 2
    exec_start kernarium_net_setup

# A phone stays awake while a USB host is connected; the host of this machine
# reaches adbd over a network that cannot wake a suspended guest, so adbd
# reports its host in sys.kernarium.adb.host_connected and the blocker, a
# userspace wakelock, keeps Android from autosuspending while one is there. Only
# Android's own autosuspend is held back: a suspend the host requests does not
# pass through the wakelock counter.
service suspend_blocker /vendor/bin/suspend_blocker
    user root
    group system
    disabled

on property:sys.kernarium.adb.host_connected=1
    start suspend_blocker

on property:sys.kernarium.adb.host_connected=0
    stop suspend_blocker

# The boot command line expedites RCU grace periods, which shortens boot.
# Normal grace periods return once boot completes, so a running guest does not
# interrupt every vCPU for each one.
#
# Swap goes on at the same point, so boot compresses nothing: the cached apps
# that started around boot completion keep their anonymous memory in zram, a
# swap of half the RAM that zswap fronts, instead of in guest RAM that nothing
# can reclaim.
on property:sys.boot_completed=1
    write /sys/kernel/rcu_expedited 0
    swapon_all /vendor/etc/fstab.uml

service bugreport /system/bin/dumpstate -d -p -z
    class main
    user root
    disabled
    oneshot
    keycodes 30 48

on early-init && property:ro.boot.enable_bootanimation=0
    setprop debug.sf.nobootanimation 1
